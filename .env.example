# === 服务配置 ===
HOST=127.0.0.1
PORT=8099

# === JWT ===
# 首次启动自动生成，无需手动配置
# JWT_SECRET=your-secret-here
JWT_EXPIRY_HOURS=24

# === LLM 配置（DeepSeek）===
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash

# === MiMo 备选 LLM ===
MIMO_API_KEY=your-mimo-key
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5

# === 向量检索（可选）===
SILICONFLOW_API_KEY=your-siliconflow-key
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu

# === 联网搜索（可选）===
# TAVILY_API_KEY=your-tavily-key

# === 数据库 ===
DB_PATH=data/rag.db

# === 跨域 ===
CORS_ORIGINS=http://localhost:4999,http://127.0.0.1:4999

# === Feature Flags（1=启用, 0=禁用）===
RAG_CHROMA=1
RAG_JIEBA=1
RAG_DYNAMIC_RANKING=1
RAG_RERANK=1
RAG_GRAPH_RECALL=1
RAG_ENTITY_EXTRACT=1
RAG_ENTITY_LLM=0
RAG_PDF_OCR=auto
RAG_STREAM_INGEST=1
RAG_IMAGE_EXTRACT=1
RAG_LANG_FILTER=1
RAG_FEEDBACK_ENABLE=0
