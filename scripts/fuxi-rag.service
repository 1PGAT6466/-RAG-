# 伏羲 RAG — systemd unit（#17，2026-09-21）
#
# 安装：
#   sudo cp scripts/fuxi-rag.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now fuxi-rag
#
# 说明：保持 workers=1 是 SQLite 单写者的正确选择；守护（Restart=always）
#       不等于多 worker。崩溃自动拉起，日志走 journalctl。

[Unit]
Description=Fuxi RAG Server (FastAPI + SQLite single-writer)
After=network.target

[Service]
Type=simple
# 修改为实际项目路径与 python 解释器
WorkingDirectory=/opt/fuxi-rag
ExecStart=/opt/fuxi-rag/.venv/bin/python server.py
Restart=always
RestartSec=5
# 优雅停止：给入库任务落 checkpoint 的时间
TimeoutStopSec=30
KillSignal=SIGTERM
# 环境变量（也可用 EnvironmentFile=/opt/fuxi-rag/.env）
# Environment=HOST=0.0.0.0
# Environment=PORT=8099
StandardOutput=journal
StandardError=journal
# 安全加固（按需调整）
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
